#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  if ENV.fetch("RAILS_ENV", "development") != "production" && !ENV["DATABASE_URL"] && !ENV["PGHOST"]
    puts "\n== Starting local PostgreSQL =="
    system! "docker", "compose", "up", "-d", "--wait", "db"
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Preparing Ruby judge =="
  if system("docker", "info", out: File::NULL, err: File::NULL)
    system! "bin/judge-build"
  else
    warn "Docker is not running. You can develop pages/models; start Docker and run bin/judge-build before judging code."
  end

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush
    exec "bin/dev"
  end
end
